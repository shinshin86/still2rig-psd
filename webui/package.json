{
  "name": "@still2rig-psd/webui",
  "version": "0.1.0",
  "private": true,
  "description": "Built-in local browser preview for generated Still2Rig PSD files.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "qa": "node scripts/run-qa.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.21",
    "ag-psd": "31.0.2"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "license": "MIT"
}
